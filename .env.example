# OpenSpeaker API Configuration
# OpenSpeaker API Key (header xi-api-key). Obtain from your OpenSpeaker / ElevenLabs provider.
OPENSPEAKER_API_KEY=""

# Base URL for the OpenSpeaker API. Default is https://api.ai33.pro
OPENSPEAKER_API_BASE_URL="https://api.ai33.pro"

# Maximum character count for text-to-speech generation (protects API credits)
MAX_TEXT_CHARS=50000

# Optional app-level access code. If configured, users must enter this code before generating speech.
APP_ACCESS_CODE=""

# Optional comma-separated hostnames allowed for audio proxy / download streaming
AUDIO_HOST_ALLOWLIST="api.ai33.pro"
